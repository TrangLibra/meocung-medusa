{
  "version": 2,
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/app/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://meocung-medusa.onrender.com/auth/$1"
    },
    {
      "source": "/admin/(.*)",
      "destination": "https://meocung-medusa.onrender.com/admin/$1"
    },
    {
      "source": "/store/(.*)",
      "destination": "https://meocung-medusa.onrender.com/store/$1"
    },
    {
      "source": "/app/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/posts-data.js",
      "destination": "/posts-data.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
